POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos

DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@db:5432/lifeos

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed origins for direct (non-proxied) API access
CORS_ORIGINS=http://localhost:5173

# Set to true only when served over HTTPS
COOKIE_SECURE=false

# Used by the Vite dev server to proxy /api requests inside Docker
VITE_API_PROXY_TARGET=http://backend:8000
